# ============================================================================
# Mm-Mp Environment Configuration Template
# ============================================================================

# Dedicated PostgreSQL 18 Cluster (Default Port 5435)
PGPORT=5435
DATABASE_URL=postgres://menu_admin:your_admin_password@127.0.0.1:5435/menumini_db?sslmode=disable
MENU_MERCHANT_DATABASE_URL=postgres://menu_workspace_runtime:your_merchant_password@127.0.0.1:5435/menumini_db?sslmode=disable
MENU_PUBLIC_DATABASE_URL=postgres://menu_customer:your_customer_password@127.0.0.1:5435/menumini_db?sslmode=disable
MENU_GUEST_DATABASE_URL=postgres://menu_guest_runtime:your_guest_password@127.0.0.1:5435/menumini_db?sslmode=disable

# Application Origins & Microservices
MENU_PUBLIC_ORIGIN="http://127.0.0.1:5173"
GO_PORT=8080
PYTHON_PORT=5001
WEB_PORT=5173

# Cryptographic Keys (32-byte base64url keys)
MENU_GUEST_CAPABILITY_KEY="your_base64url_32_byte_key_here"
